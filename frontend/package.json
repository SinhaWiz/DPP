{
  "name": "@dpp/frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive visualizer for the buy/sell ledger",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
